{
	"schemaVersion": 1,
	"id": "ludigen",
	"version": "${version}",
	"name": "LudiGen",
	"description": "GPU-accelerated Terrain Generation at Ludicrous Speeds",
	"authors": ["Endrf"],
	"contributors": [
		"ryanred10"
	],
	"contact": {
		"homepage": "https://github.com/LudicrousMC",
		"sources": "https://github.com/LudicrousMC/ludigen"
	},
	"license": "MIT",
	"icon": "assets/ludigen/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.endrf.LudiGen"
		],
		"client": [
			"com.endrf.client.LudiGenClient"
		]
	},
	"mixins": [
		"ludigen.mixins.json",
		{
			"config": "ludigen.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "ludigen.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}